{
  "name": "global-persons-hub",
  "version": "0.1.0",
  "private": true,
  "description": "全球知名人物志 · 前后端分离的人物数据库平台（全领域 / 全语种 / 知识图谱 / SEO+GEO 友好）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w @gph/api run dev",
    "dev:web": "npm -w @gph/web run dev",
    "build": "npm -w @gph/web run build",
    "start:api": "npm -w @gph/api run start",
    "start:web": "npm -w @gph/web run start",
    "typecheck": "npm -w @gph/types run typecheck && npm -w @gph/api run typecheck && npm -w @gph/web run typecheck",
    "gen:og-font": "node scripts/gen-og-font.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:reindex": "npm -w @gph/api run reindex-graph",
    "db:reembed": "npm -w @gph/api run reindex-embed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
