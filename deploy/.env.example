# ============================================================
# 全球知名人物志 · 生产环境变量模板
# 部署时由 lighthouse-deploy.ps1 写入对应目录的 .env
# 注意：NEXT_PUBLIC_* 在 next build 期已内联，必须构建前就设好；
#       此处仅作记录，运行时真正的服务端变量是 GPH_* 与 STORE_DRIVER 等。
# ============================================================

# —— Web（写入 .next/standalone/apps/web/.env，server.js 启动时读取）——
# 公开站点地址（canonical / sitemap / OG metadataBase 都用它，必须含协议与端口）
NEXT_PUBLIC_SITE_URL=http://<PUBLIC_IP>:3000
# 浏览器端 API 基址：同源相对路径，经 next.config 的 /api 重写代理到后端
NEXT_PUBLIC_API_BASE=/api
# 服务端（SSR/ISR）取数基址：与 API 同机走 127.0.0.1
GPH_API_BASE=http://127.0.0.1:8787
# ISR 再生窗口（秒）
GPH_REVALIDATE=300

# —— API（写入 apps/api/.env）——
# 生产标识：开启严格安全校验（弱 JWT_SECRET / 弱管理员口令将拒绝启动）
NODE_ENV=production
PORT=8787
# API 监听地址：仅本机取数（Web 经 /api 重写代理），不对外暴露，固定 127.0.0.1
API_BIND=127.0.0.1
# 零依赖 JSON 存储（免 PostgreSQL/Neo4j），生产先用这个快速上线
STORE_DRIVER=json
# 务必改成随机强串（≥32 位）。生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 留空 / 保留占位值 / 少于 32 位 → 生产环境将直接拒绝启动
JWT_SECRET=change-me-to-a-long-random-string
GPH_ADMIN_EMAIL=admin@gph.local
# 至少 12 位且不得为示例值，否则生产环境拒绝启动
GPH_ADMIN_PASSWORD=change-me-admin-password

# —— 可选安全开关 ——
# 跨域白名单（逗号分隔）；'*' 表示全放行。未设置时：生产收紧为同源，开发放行
# CORS_ORIGINS=https://example.com
# 在非 production 环境也启用严格密钥校验
# GPH_STRICT_SECRETS=1
# 应急放行弱配置（强烈不建议长期开启）
# GPH_ALLOW_WEAK_SECRETS=1
