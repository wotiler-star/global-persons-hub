{
  "name": "@gph/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --external:fastify --external:@fastify/cors --external:@fastify/jwt --external:dotenv --external:pg --external:neo4j-driver --external:@xenova/transformers",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "reindex-graph": "tsx src/store/reindex-graph.ts",
    "reindex-embed": "tsx src/store/reindex-embed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@gph/types": "*",
    "dotenv": "^16.6.1",
    "fastify": "^4.28.1",
    "neo4j-driver": "^5.27.0",
    "pg": "^8.13.1"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^1.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
